# Default: normalize to LF so hashes computed in CI match local checkouts.
* text=auto eol=lf

# Ledger records and signatures are content-addressed by exact bytes.
# Later lines win in .gitattributes, so these overrides must come last.
# Never let Git rewrite their line endings on any platform.
attestations/** -text
revocations/** -text
admissions/** -text
stewards/** -text
*.asc -text
